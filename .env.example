# Server-side only. Never prefix any of these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Seeded as the archive's first admin the first time an empty database starts.
# Required for a fresh deployment: without it, startup stops with
# owner_email_not_configured rather than seeding nobody.
OWNER_EMAIL=

# The family or archive name shown in exports, digest emails, and metadata.
ARCHIVE_NAME=

# Comma-separated emails seeded as editors alongside the owner on first run.
EDITOR_EMAILS=

# Sign-in configuration. Keep private keys and secrets server-side
# (wrangler secret put), never in vars or in this file.
PUBLIC_ORIGIN=https://example.com
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
AUTH_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
