{
  "name": "treetree",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "gate": "npm test && npm run typecheck && npm run lint && npm run build",
    "deploy": "npm run build && node scripts/normalize-deploy-config.mjs && wrangler deploy --keep-vars",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.10",
    "next": "16.3.8",
    "openai": "^7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20260930.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0",
    "vite": "8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "4.145.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "satori": {
      "fflate": "^0.7.5"
    }
  },
  "type": "module",
  "license": "MIT"
}
